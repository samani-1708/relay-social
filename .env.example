# App
APP_NAME=relayman
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Monolith (docker-compose local-db profile):
DATABASE_URL=postgresql://relayman:relayman@localhost:5432/relayman
# Cloud SQL (GCP Compute Engine via private IP):
# DATABASE_URL=postgresql://user:pass@10.x.x.x:5432/relayman
# Cloud SQL (Cloud Run via Unix socket):
# DATABASE_URL=postgresql://user:pass@localhost/relayman?host=/cloudsql/PROJECT:REGION:INSTANCE

# ── Redis ─────────────────────────────────────────────────────────────────────
# Monolith (docker-compose local-redis profile):
REDIS_URL=redis://localhost:6379
# Cloud Memorystore (GCP):
# REDIS_URL=redis://10.x.x.x:6379

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# NextAuth (web)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Google OAuth (for app sign-in — create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Token encryption — AES-256-GCM key (must be exactly 64 hex chars = 32 bytes)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-in-production

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@relayman.io

# ── Storage ───────────────────────────────────────────────────────────────────
# Select provider:  s3 (MinIO / AWS S3 / Cloudflare R2)  |  gcs (Google Cloud Storage)
STORAGE_PROVIDER=s3

# -- S3 / MinIO (used when STORAGE_PROVIDER=s3) --
# MinIO monolith (docker-compose local-storage profile):
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=relayman-media
# Must be publicly reachable by Instagram/TikTok — set to VM external IP or domain:
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/relayman-media
# AWS S3 (omit STORAGE_ENDPOINT; set real region):
# STORAGE_ENDPOINT=
# STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=AKIA...
# STORAGE_SECRET_KEY=...

# MinIO root credentials (docker-compose only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -- GCS (used when STORAGE_PROVIDER=gcs) --
# On GCE / Cloud Run: leave GCS_KEY_FILE empty — ADC is used automatically.
# Locally: point GCS_KEY_FILE at your downloaded service-account JSON.
GCS_PROJECT_ID=
GCS_BUCKET=relayman-media
GCS_KEY_FILE=

# Twitter / X
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Note: requires Twitter Basic API tier ($100/mo) for tweet.write scope

# BlueSky (uses App Password auth — no OAuth app registration needed)
# Users provide their own handle + app password via the UI

# Meta (Facebook, Instagram, Threads — one app for all three)
META_APP_ID=
META_APP_SECRET=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Mastodon (per-instance; stored per user in DB)
# No global credentials needed — registered dynamically per instance
